# Copy this file to .env.local and replace each placeholder.
DATABASE_URL=postgres://user:password@host:5432/dbname
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# NEXT_PUBLIC_* are inlined at build time for client-side use (signup
# page uses the browser Supabase client).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth.js (NextAuth v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# OAuth providers (configure in Supabase Auth dashboard; see README for steps)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# R2 jurisdiction (eu, us, etc.)
R2_JURISDICTION=eu
